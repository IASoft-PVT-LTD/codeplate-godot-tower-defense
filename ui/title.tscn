[gd_scene format=3]

[ext_resource type="Script" path="res://ui/title.gd" id="1_title"]
[ext_resource type="Texture2D" path="res://assets/ui/title_bg.png" id="2_bg"]

[node name="Title" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 0
offset_right = 480.0
offset_bottom = 270.0
texture = ExtResource("2_bg")

[node name="Rows" type="VBoxContainer" parent="."]
layout_mode = 0
offset_top = 30.0
offset_right = 480.0
offset_bottom = 262.0
theme_override_constants/separation = 6

[node name="Logo" type="Label" parent="Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 40
text = "LANTERN KEEP"
horizontal_alignment = 1

[node name="Tagline" type="Label" parent="Rows"]
layout_mode = 2
theme_type_variation = &"SmallLabel"
text = "LIGHT THE LANTERNS. HOLD THE SHRINE."
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Rows"]
custom_minimum_size = Vector2(0, 54)
layout_mode = 2

[node name="Stars" type="Label" parent="Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SmallLabel"
horizontal_alignment = 1

[node name="PlayButton" type="Button" parent="Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "PLAY"

[node name="SettingsButton" type="Button" parent="Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "SETTINGS"

[node name="Hint" type="Label" parent="Rows"]
layout_mode = 2
theme_type_variation = &"SmallLabel"
text = "TAP A TILE TO BUILD  -  NUMBER KEYS BUILD  -  SPACE NEXT WAVE  -  F SPEED"
horizontal_alignment = 1
